line level    source

   1          /********************************************************
   2           *  STC89C51 单舵机 PWM 控制示例
   3           *  晶振：11.0592 MHz
   4           *  定时器 0 工作方式 1，产生 0.1 ms 基准时基
   5           *  P1.0 输出 20 ms 周期 PWM
   6           *  angle: 0°~180° 线性对应 0.5 ms~2.5 ms
   7           ********************************************************/
   8          #include <REG51.H>
   9          
  10          sbit SERVO = P1^0;          // 舵机信号脚
  11          
  12          /* 根据晶振计算 0.1 ms 的 TH0/TL0 重装值 */
  13          #define CRYSTAL   11059200L  // 当前晶振频率
  14          #define PER_01MS  (65536 - CRYSTAL/12/10000)   // 0.1 ms 计数值
  15          unsigned int reload = PER_01MS;
  16          
  17          volatile unsigned int  high_01ms = 15;   // 1.5 ms 缺省中位
  18          volatile unsigned int  cnt_01ms  = 0;    // 0.1 ms 计数器
  19          
  20          /* 简易毫秒延时（晶振 11.0592 MHz） */
  21          void Delay_ms(unsigned int ms)
  22          {
  23   1          unsigned int i,j;
  24   1          for(i=ms; i>0; i--)
  25   1              for(j=110; j>0; j--);
  26   1      }
  27          
  28          /* ----------------------------------------------
  29           * 设置角度：0~max_angle 度
  30           * ----------------------------------------------*/
  31          void set_servo_angle(unsigned char angle, unsigned char max_angle)
  32          {
  33   1          if(angle > max_angle) angle = max_angle;
  34   1      
  35   1          /* 0° -> 5 个 0.1ms = 0.5 ms
  36   1             180° -> 25 个 0.1ms = 2.5 ms */
  37   1          high_01ms = 5 + (angle * 20)/180;
  38   1      }
  39          
  40          /* ----------------------------------------------
  41           * T0 中断服务：每 0.1 ms 进入一次
  42           * ----------------------------------------------*/
  43          void timer0_ISR(void) interrupt 1
  44          {
  45   1          TH0 = reload >> 8;
  46   1          TL0 = reload;
  47   1      
  48   1          if(++cnt_01ms >= 200)      // 20 ms 到，重新开始周期
  49   1              cnt_01ms = 0;
  50   1      
  51   1          SERVO = (cnt_01ms < high_01ms);
  52   1      }
  53          
  54          /* ----------------------------------------------
C51 COMPILER V9.60.7.0   MAIN                                                              08/13/2025 17:01:01 PAGE 2   

  55           * 初始化定时器 0
  56           * ----------------------------------------------*/
  57          void timer0_init(void)
  58          {
  59   1          TMOD &= 0xF0;              // T0 方式 1
  60   1          TMOD |= 0x01;
  61   1      
  62   1          TH0 = reload >> 8;
  63   1          TL0 = reload;
  64   1      
  65   1          ET0 = 1;                   // 开 T0 中断
  66   1          EA  = 1;                   // 开总中断
  67   1          TR0 = 1;                   // 启动 T0
  68   1      }
  69          
  70          /* ----------------------------------------------
  71           * 主函数：循环扫描串口或按键，改变角度
  72           * ----------------------------------------------*/
  73          void main(void)
  74          {
  75   1          timer0_init();
  76   1          set_servo_angle(90, 180);       // 先回到中位
  77   1      
  78   1          while(1)
  79   1          {
  80   2              /* 示例：每隔 1 s 做一次 0°→90°→180°→90° 摆动 */
  81   2              set_servo_angle(0, 180);    Delay_ms(1000);
  82   2              set_servo_angle(90, 180);   Delay_ms(1000);
  83   2              set_servo_angle(180, 180);  Delay_ms(1000);
  84   2              set_servo_angle(90, 180);   Delay_ms(1000);
  85   2          }
  86   1      }


