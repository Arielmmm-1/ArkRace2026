line level    source

   1          /********************************************************
   2           *  STC89C51 单舵机 PWM 控制示例
   3           *  晶振：11.0592 MHz
   4           *  定时器 0 工作方式 1，产生 0.1 ms 基准时基
   5           *  P1.0 输出 20 ms 周期 PWM
   6           *  angle: 0°~180° 线性对应 0.5 ms~2.5 ms
   7           ********************************************************/
   8          #include <REG51.H>
   9          
  10          sbit SERVO = P1^0;          // 舵机信号脚
  11          
  12          /* 根据晶振计算 0.1 ms 的 TH0/TL0 重装值 */
  13          #define CRYSTAL   11059200L  // 当前晶振频率
  14          #define PER_01MS  (65536 - CRYSTAL/12/10000)   // 0.1 ms 计数值
  15          unsigned int reload = PER_01MS;
  16          
  17          volatile unsigned int  high_01ms = 15;   // 1.5 ms 缺省中位
  18          volatile unsigned int  cnt_01ms  = 0;    // 0.1 ms 计数器
  19          
  20          /* ----------------------------------------------
  21           * 设置角度：0~max_angle 度
  22           * ----------------------------------------------*/
  23          void set_servo_angle(unsigned char angle, unsigned char max_angle)
  24          {
  25   1          if(angle > max_angle) angle = max_angle;
  26   1      
  27   1          /* 0° -> 5 个 0.1ms = 0.5 ms
  28   1             180° -> 25 个 0.1ms = 2.5 ms */
  29   1          high_01ms = 5 + (angle * 20)/180;
  30   1      }
  31          
  32          /* ----------------------------------------------
  33           * T0 中断服务：每 0.1 ms 进入一次
  34           * ----------------------------------------------*/
  35          void timer0_ISR(void) interrupt 1
  36          {
  37   1          TH0 = reload >> 8;
  38   1          TL0 = reload;
  39   1      
  40   1          if(++cnt_01ms >= 200)      // 20 ms 到，重新开始周期
  41   1              cnt_01ms = 0;
  42   1      
  43   1          SERVO = (cnt_01ms < high_01ms);
  44   1      }
  45          
  46          /* ----------------------------------------------
  47           * 初始化定时器 0
  48           * ----------------------------------------------*/
  49          void timer0_init(void)
  50          {
  51   1          TMOD &= 0xF0;              // T0 方式 1
  52   1          TMOD |= 0x01;
  53   1      
  54   1          TH0 = reload >> 8;
C51 COMPILER V9.60.7.0   MAIN                                                              08/13/2025 17:01:30 PAGE 2   

  55   1          TL0 = reload;
  56   1      
  57   1          ET0 = 1;                   // 开 T0 中断
  58   1          EA  = 1;                   // 开总中断
  59   1          TR0 = 1;                   // 启动 T0
  60   1      }
  61          
  62          /* ----------------------------------------------
  63           * 主函数：循环扫描串口或按键，改变角度
  64           * ----------------------------------------------*/
  65          void main(void)
  66          {
  67   1          timer0_init();
  68   1          set_servo_angle(90, 180);       // 先回到中位
  69   1      
  70   1          while(1)
  71   1          {
  72   2      
  73   2          }
  74   1      }
  75          


